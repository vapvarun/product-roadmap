# Files and folders to exclude from distribution
# This file is used by wp dist-archive command

# Version control
.git
.gitignore
.github
.distignore

# Distribution archives (old releases)
dist

# Development files
node_modules
vue-app/node_modules

# Backup files - CRITICAL to exclude
*.bak
*~
*.backup
*.tmp
*.log
*.swp
.DS_Store
Thumbs.db

# Test files
tests
test-*.html
test-*.php
phpunit.xml
phpunit.xml.dist

# Build files we don't need in distribution
*.map
*.scss.map
build.sh
build-all.sh
build-rtl.js
bin/build-release.sh
verify-compliance.sh

# Documentation files (keep README.md for transparency)
MARKETING-IMAGES.md
SNEAK-PEEK.md
sales-page-*.html
BUILD.md
WORDPRESS-COMPLIANCE.md

# Development configs that users don't need
.editorconfig
.eslintrc
.eslintrc.js
.eslintignore
.prettierrc
.stylelintrc
.babelrc
.browserslistrc
phpcs.xml
phpcs.xml.dist

# IDE files
.idea
.vscode
*.sublime-project
*.sublime-workspace

# Keep these files for WordPress compliance:
# - vue-app/src (source files)
# - build.sh (build instructions)
# - package.json (dependencies)
# - README.md (documentation)
# Dev tooling added for release gating (not for distribution)
# Anchor to /vendor: drop ONLY the top-level composer dir, NEVER
# assets/vendor/* (runtime libs like select2 must ship).
/vendor
composer.json
composer.lock
phpstan.neon
phpstan-bootstrap.php
phpstan-baseline.neon
audit
plan
.contract-audit-baseline.json

# Repo documentation (not shipped to customers)
docs

# Internal marketing assets (not shipped)
marketing

# All Markdown is internal docs (WordPress uses readme.txt, not .md).
# Blanket-exclude so a new internal .md can never leak into a build again.
*.md
