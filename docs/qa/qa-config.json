{
  "$schema": "https://wpmediaverse.com/schemas/wp-plugin-qa-config-v1.json",
  "slug": "product-roadmap",
  "name": "Product Roadmap",
  "version_constant": "ROADMAP_VERSION",
  "main_file": "product-roadmap.php",
  "base_url": "http://roadmap.local",
  "wp_path": null,
  "autologin_param": "autologin",
  "rest_namespace": "roadmap/v1",
  "front_routes": [
    "/board-view/",
    "/poll-roadmap/",
    "/timeline-view/",
    "/list-view/",
    "/cards-view/",
    "/minimal-view/"
  ],
  "pair": {
    "pro_slug": "roadmap-pro-addon",
    "pro_version_constant": "ROADMAP_PRO_VERSION",
    "pro_main_file": "roadmap-pro-addon.php",
    "lockstep": true
  },
  "basecamp": {
    "project_id": 43291050,
    "bugs_column_id": 8905657766,
    "ready_for_testing_column_id": 8905657772
  },
  "modes": ["free", "combo"],
  "report_path": "docs/qa/.last-smoke-pass.json",
  "supplements_path": null,
  "_wp_path_note": "Deliberately null. Same repo is checked out on several machines under different $HOME values; wp-plugin-smoke derives the WP root from the plugin's own location instead.",

  "site": "http://roadmap.local",
  "themes": {
    "primary": "buddyx",
    "generic": "twentytwentyfive"
  },
  "pages": {
    "board_default": "http://roadmap.local/board-view/",
    "poll_roadmap": "http://roadmap.local/poll-roadmap/",
    "timeline": "http://roadmap.local/timeline-view/",
    "list": "http://roadmap.local/list-view/",
    "cards": "http://roadmap.local/cards-view/",
    "minimal": "http://roadmap.local/minimal-view/",
    "scale": "http://roadmap.local/scale-test-alpha/",
    "settings": "http://roadmap.local/wp-admin/admin.php?page=roadmap-settings",
    "dashboard": "http://roadmap.local/wp-admin/admin.php?page=roadmap-dashboard"
  },
  "seed": {
    "note": "Scale seed uses post meta _seeded=1 (~1000 items). Teardown: wp post delete $(wp post list --post_type=roadmap_item --meta_key=_seeded --meta_value=1 --format=ids) --force",
    "items_meta_key": "_seeded",
    "items_meta_value": "1"
  },
  "personas": [
    { "login": "qa_member_owner", "role": "subscriber",    "email": "qa_member_owner@example.test", "rung": "member-owner", "note": "votes/comments/suggests; owns their own content" },
    { "login": "qa_member_other", "role": "subscriber",    "email": "qa_member_other@example.test", "rung": "member-other", "note": "SAME role as member-owner; exists to catch ownership-vs-role gaps" },
    { "login": "qa_contrib",      "role": "contributor",   "email": "qa_contrib@example.test",      "rung": "low-privilege", "note": "lowest rung holding edit_posts - the rung REST routes leak to" },
    { "login": "qa_elevated",     "role": "editor",        "email": "qa_elevated@example.test",     "rung": "elevated",     "note": "roadmap_edit_items / roadmap_delete_items" },
    { "login": "qa_admin",        "role": "administrator", "email": "qa_admin@example.test",        "rung": "admin",        "note": "control rung - never the only rung walked" }
  ],
  "anonymous": { "rung": "anonymous", "note": "guest voting + guest suggestions default ON" }
}
